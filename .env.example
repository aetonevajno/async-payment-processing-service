PAYMENTS_API_KEY=replace-with-a-local-development-key
PAYMENTS_DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
PAYMENTS_RABBITMQ_URL=amqp://payments:payments@localhost:5672/
PAYMENTS_RABBITMQ_CONNECTION_TIMEOUT=10
PAYMENTS_DB_POOL_SIZE=5
PAYMENTS_DB_MAX_OVERFLOW=5
PAYMENTS_DB_POOL_TIMEOUT=10
PAYMENTS_LOG_LEVEL=INFO
PAYMENTS_OUTBOX_POLL_INTERVAL=1
PAYMENTS_OUTBOX_PUBLISH_TIMEOUT=10
PAYMENTS_OUTBOX_RETRY_BASE=1
PAYMENTS_OUTBOX_RETRY_MAX=60
PAYMENTS_PROCESSING_RETRY_BASE=1
PAYMENTS_WEBHOOK_TIMEOUT=10
PAYMENTS_WEBHOOK_PRIVATE_HOSTS=[]
